# ==============================================================================
# AGRINEXUS FRONTEND ENVIRONMENT VARIABLES (Vercel / Vite Client)
# ==============================================================================
# NOTE: All frontend variables MUST be prefixed with 'VITE_'.
# Any variable defined here is exposed to the browser bundle.
# NEVER put database URIs, JWT secrets, or private Bhashini API keys here!
# ==============================================================================

# Backend REST API Base URL
# Development: http://localhost:5001/api
# Production (Vercel): https://your-agrinexus-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:5001/api

# Backend Real-time WebSocket Server URL
# Development: http://localhost:5001
# Production (Vercel): https://your-agrinexus-backend.onrender.com
VITE_SOCKET_URL=http://localhost:5001

# Google Maps JavaScript API Key (Browser Key)
# Optional: If omitted or left blank, AgriNexus automatically falls back
# to the built-in Leaflet / OpenStreetMap GIS engine without errors.
# IMPORTANT: In production Google Cloud Console, restrict this key with
# HTTP referrer restrictions to your Vercel domain (e.g., https://*.vercel.app/*).
VITE_GOOGLE_MAPS_API_KEY=your_restricted_google_maps_key

# Active Client Application Environment ('development' | 'production')
VITE_APP_ENV=development
