# AgriNexus Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:5001/api
VITE_SOCKET_URL=http://localhost:5001

# Google Maps API Configuration
# Required Google Cloud APIs to enable:
# 1. Maps JavaScript API (for interactive map and custom markers)
# 2. Places API (for address search / autocomplete)
# 3. Geocoding API (for reverse geocoding and coordinates confirmation)
# If left blank or missing, AgriNexus automatically falls back to the built-in Leaflet map without error.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
