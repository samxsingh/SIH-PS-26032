# ==============================================================================
# AGRINEXUS FRONTEND (VITE) ENVIRONMENT VARIABLES
# ==============================================================================
# All variables consumed by Vite MUST be prefixed with VITE_.
# DO NOT put database URLs or backend secrets in this file.

# Backend REST API Base URL
VITE_API_BASE_URL=http://localhost:5001/api

# Real-time WebSocket Server URL
VITE_SOCKET_URL=http://localhost:5001

# Google Maps JavaScript API Key (Optional)
# If left blank, AgriNexus automatically falls back to OpenStreetMap/Leaflet with zero errors.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
