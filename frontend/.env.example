# ==============================================================================
# AGRINEXUS — FRONTEND ENVIRONMENT CONFIGURATION (frontend/.env.example)
# ==============================================================================
# In Vite, only variables prefixed with 'VITE_' are exposed to client-side code.
# Never expose sensitive database credentials or JWT secrets here.
# ==============================================================================

# Backend REST API Base URL
VITE_API_BASE_URL=http://localhost:5001/api

# Backend WebSocket Server URL (for live queue updates)
VITE_SOCKET_URL=http://localhost:5001

# Optional: Google Maps API Key
# If omitted or invalid, the platform automatically and gracefully falls back
# to the built-in Leaflet / OpenStreetMap engine with zero UI errors.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
