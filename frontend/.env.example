# ==============================================================================
# AGRINEXUS FRONTEND CANONICAL ENVIRONMENT VARIABLES (Vercel / Vite Client)
# ==============================================================================
# NOTE: All frontend variables MUST be prefixed with 'VITE_'.
# Any variable defined here is bundled into the client-side JavaScript artifact.
# NEVER put database URIs, JWT secrets, admin passwords, or private API keys here!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND CONNECTIVITY
# ------------------------------------------------------------------------------
# [REQUIRED in Prod] [PUBLIC] Backend REST API Base URL
# Development: http://localhost:5001/api
# Production (Vercel): https://your-agrinexus-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:5001/api

# [REQUIRED in Prod] [PUBLIC] Backend Real-time WebSocket Server URL
# Development: http://localhost:5001
# Production (Vercel): https://your-agrinexus-backend.onrender.com
VITE_SOCKET_URL=http://localhost:5001

# ------------------------------------------------------------------------------
# 2. APPLICATION RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# [OPTIONAL] [PUBLIC] Active Client Application Environment ('development' | 'production')
# Default: development
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# 3. GOOGLE MAPS JAVASCRIPT API (Browser GIS) — OPTIONAL
# ------------------------------------------------------------------------------
# [OPTIONAL] [PUBLIC] Google Maps JavaScript API Key
# If omitted or empty, AgriNexus automatically falls back to Leaflet & OpenStreetMap
# with ZERO runtime errors and full feature support.
# If used in production, restrict with HTTP referrer to https://*.vercel.app/*
VITE_GOOGLE_MAPS_API_KEY=

