# ==============================================================================
# AGRINEXUS — BACKEND ENVIRONMENT CONFIGURATION (backend/.env.example)
# ==============================================================================

# Node Runtime Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port
PORT=5001

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/smart_procurement_db

# CORS Allowed Client Origin
CLIENT_URL=http://localhost:5173

# Authentication (JWT)
# REQUIRED in production. Generate a strong random string (e.g. openssl rand -base64 32)
JWT_SECRET=replace_with_strong_random_secret_minimum_32_chars
JWT_EXPIRES_IN=24h

# Demo Administrator Credentials
ADMIN_EMAIL=admin@agrinexus.gov.in
ADMIN_PASSWORD=adminpassword
