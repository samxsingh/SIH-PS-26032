# ==============================================================================
# AGRINEXUS BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://localhost:27017/smart_procurement_db
CLIENT_URL=http://localhost:5173

# Authentication & Security
JWT_SECRET=replace_with_strong_random_secret_minimum_32_chars
JWT_EXPIRES_IN=24h

# Pre-provisioned Admin Credentials
ADMIN_EMAIL=admin@agrinexus.gov.in
ADMIN_PASSWORD=adminpassword

# Digital India Bhashini APIs (Optional / Failure-tolerant)
# If omitted, system serves built-in static translations with zero errors.
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_PIPELINE_ID=64392f96daac500b55c543d6
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
