# ==============================================================================
# AGRINEXUS BACKEND CANONICAL ENVIRONMENT VARIABLES (Render / Express)
# ==============================================================================
# Canonical reference for all environment variables consumed by the AgriNexus backend.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# [OPTIONAL] [PUBLIC] Active environment ('development' | 'production' | 'test')
# Default: development
NODE_ENV=development

# [OPTIONAL] [PUBLIC] Server port (Render dynamically provides process.env.PORT)
# Default: 5001
PORT=5001

# [REQUIRED in Prod] [PUBLIC] Deployed Frontend URL (Vercel)
# Local: http://localhost:5173 | Prod: https://your-agrinexus.vercel.app
FRONTEND_URL=http://localhost:5173

# [OPTIONAL] [PUBLIC] Allowed web origins for REST API CORS (comma-separated)
# In production, specify your Vercel production domain(s)
CORS_ORIGINS=http://localhost:5173

# [OPTIONAL] [PUBLIC] Allowed origins for Socket.IO WebSocket connections (comma-separated)
SOCKET_CORS_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# [REQUIRED in Prod] [SECRET] MongoDB connection URI
# Local: mongodb://localhost:27017/smart_procurement_db
# Prod: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/agrinexus?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/smart_procurement_db

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# [REQUIRED in Prod] [SECRET] Secret key for signing JSON Web Tokens (min 32 characters)
# Startup will abort in production if unset or using default fallback!
JWT_SECRET=super_secret_sih_2026_gov_key_change_in_production

# [OPTIONAL] [PUBLIC] Token expiration duration (e.g., 24h, 7d)
# Default: 24h
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 4. PRE-PROVISIONED DEMO ADMINISTRATOR CREDENTIALS
# ------------------------------------------------------------------------------
# [OPTIONAL] [PUBLIC] Official Government Admin login email
# Default: admin@agrinexus.gov.in
ADMIN_EMAIL=admin@agrinexus.gov.in

# [OPTIONAL] [SECRET] Official Government Admin login password
# Default: adminpassword
ADMIN_PASSWORD=adminpassword

# ------------------------------------------------------------------------------
# 5. PAYMENT PROCESSING MODE
# ------------------------------------------------------------------------------
# [OPTIONAL] [PUBLIC] Payment pipeline mode ('SIMULATED' | 'DEMO' | 'PRODUCTION')
# Default: SIMULATED
PAYMENT_MODE=SIMULATED

# ------------------------------------------------------------------------------
# 6. DIGITAL INDIA BHASHINI APIS (MeitY ULCA Gateway) — OPTIONAL
# ------------------------------------------------------------------------------
# If unconfigured, the server operates seamlessly with static i18n & zero errors
# [OPTIONAL] [SECRET] Bhashini API Key
BHASHINI_API_KEY=

# [OPTIONAL] [SECRET] Bhashini User ID
BHASHINI_USER_ID=

# [OPTIONAL] [PUBLIC] Bhashini Pipeline ID
# Default: 64392f96daac500b55c543d6
BHASHINI_PIPELINE_ID=64392f96daac500b55c543d6

# [OPTIONAL] [PUBLIC] Bhashini Inference Pipeline Endpoint
# Default: https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_API_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# ------------------------------------------------------------------------------
# 7. GOOGLE MAPS PLATFORM (Server-Side) — OPTIONAL
# ------------------------------------------------------------------------------
# [OPTIONAL] [SECRET] Backend Google Maps API Key for server-side geocoding/distance
# Optional: Not required for application startup or operation.
GOOGLE_MAPS_API_KEY=
