# ==============================================================================
# AGRINEXUS BACKEND ENVIRONMENT VARIABLES (Render / Node.js Express Server)
# ==============================================================================
# This template contains all required and optional environment variables
# consumed by the AgriNexus backend server.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Active runtime environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server listening port (Render automatically assigns process.env.PORT in production)
PORT=5001

# Primary frontend URL
# Local Development: http://localhost:5173
# Production (Render): https://your-agrinexus.vercel.app
FRONTEND_URL=http://localhost:5173

# Alias for backwards compatibility
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. CORS & WEBSOCKET ORIGIN SECURITY
# ------------------------------------------------------------------------------
# Comma-separated list of allowed web origins for REST API calls.
# In production, set to your Vercel deployment domain(s).
CORS_ORIGINS=http://localhost:5173

# Comma-separated list of allowed origins for real-time Socket.IO connections.
SOCKET_CORS_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (MongoDB / MongoDB Atlas)
# ------------------------------------------------------------------------------
# Local MongoDB: mongodb://localhost:27017/smart_procurement_db
# Production MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/agrinexus?retryWrites=true&w=majority
MONGODB_URI=your-mongodb-atlas-uri

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Minimum 32-character secret key for signing JSON Web Tokens.
# In production, server startup will ABORT if this is missing or insecure!
JWT_SECRET=your-jwt-secret

# JWT Token validity duration (e.g. 24h, 7d)
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 5. PRE-PROVISIONED DEMO ADMINISTRATOR CREDENTIALS
# ------------------------------------------------------------------------------
# Official Government Administrator account email
ADMIN_EMAIL=your-admin-email

# Secure Administrator password
ADMIN_PASSWORD=your-admin-password

# ------------------------------------------------------------------------------
# 6. GOOGLE MAPS PLATFORM (Server-side APIs)
# ------------------------------------------------------------------------------
# Optional server-side Google Maps API key (Geocoding, Distance Matrix).
# Keep restricted by API and IP address in Google Cloud Console.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ------------------------------------------------------------------------------
# 7. DIGITAL INDIA BHASHINI APIS (MeitY ULCA Translation Pipeline)
# ------------------------------------------------------------------------------
# If omitted or unconfigured, system operates with built-in static translations
# and serves original text with graceful zero-error fallback.
BHASHINI_API_KEY=your-bhashini-api-key
BHASHINI_USER_ID=your-bhashini-user-id
BHASHINI_PIPELINE_ID=64392f96daac500b55c543d6
BHASHINI_API_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
