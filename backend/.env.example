# AgriNexus Backend Environment Variables
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/agrinexus
JWT_SECRET=super_secret_sih_2026_gov_key_change_in_production

# Government Admin Pre-provisioned Credentials
ADMIN_EMAIL=admin@agrinexus.gov.in
ADMIN_PASSWORD=adminpassword

# Google Maps Server-side API Key (Optional)
# Used for server-side geocoding and reverse geocoding verification
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
