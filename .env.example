# ==============================================================================
# AGRINEXUS — UNIFIED FULL-STACK ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# This template defines all environment variables consumed by the AgriNexus
# platform across Backend (Node.js/Express/Socket.io) and Frontend (Vite/React).
#
# INSTRUCTIONS:
# - For Backend: Copy relevant variables to backend/.env
# - For Frontend: Copy VITE_* variables to frontend/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Active runtime environment ('development' | 'production' | 'test')
NODE_ENV=development

# HTTP & WebSocket port for the backend server (default: 5001)
PORT=5001

# MongoDB Connection URI
# Local instance or MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/smart_procurement_db

# CORS Allowed Origin for Frontend Client requests
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JWT tokens (REQUIRED in production)
JWT_SECRET=replace_with_strong_random_secret_minimum_32_chars

# JWT token expiration window (e.g. '24h', '7d')
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 3. PRE-PROVISIONED DEMO ADMINISTRATOR CREDENTIALS
# ------------------------------------------------------------------------------
# Official Government Administrator demonstration account email
ADMIN_EMAIL=admin@agrinexus.gov.in

# Pre-provisioned Administrator password
ADMIN_PASSWORD=adminpassword

# ------------------------------------------------------------------------------
# 4. FRONTEND ENVIRONMENT VARIABLES (Vite Client)
# ------------------------------------------------------------------------------
# Note: All frontend variables MUST begin with the 'VITE_' prefix.
# Never expose backend secrets (database, JWT secret) through VITE_* variables.

# Base URL for the backend REST API
VITE_API_BASE_URL=http://localhost:5001/api

# Base URL for the backend WebSocket server (real-time queue updates)
VITE_SOCKET_URL=http://localhost:5001

# Optional Google Maps JavaScript API Key
# If omitted or left blank, AgriNexus automatically falls back to the
# built-in OpenStreetMap / Leaflet GIS map engine with zero errors.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
