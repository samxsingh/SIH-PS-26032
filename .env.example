# ==============================================================================
# AGRINEXUS — FULL-STACK PRODUCTION CONFIGURATION REFERENCE (.env.example)
# ==============================================================================
# - Backend variables (Render): Copy to backend/.env
# - Frontend variables (Vercel): Copy to frontend/.env (MUST prefix with VITE_)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVER CONFIGURATION (Render)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
SOCKET_CORS_ORIGINS=http://localhost:5173

# Database (MongoDB / MongoDB Atlas)
MONGODB_URI=your-mongodb-atlas-uri

# Authentication (JWT)
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=24h

# Demo Administrator Account
ADMIN_EMAIL=your-admin-email
ADMIN_PASSWORD=your-admin-password

# Google Maps Platform (Backend)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Digital India Bhashini APIs (Backend Proxy)
BHASHINI_API_KEY=your-bhashini-api-key
BHASHINI_USER_ID=your-bhashini-user-id
BHASHINI_PIPELINE_ID=64392f96daac500b55c543d6
BHASHINI_API_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# ------------------------------------------------------------------------------
# 2. FRONTEND CLIENT CONFIGURATION (Vercel)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5001/api
VITE_SOCKET_URL=http://localhost:5001
VITE_GOOGLE_MAPS_API_KEY=your_restricted_google_maps_key
VITE_APP_ENV=development
