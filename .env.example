# ==============================================================================
# AGRINEXUS — FULL-STACK PRODUCTION CONFIGURATION REFERENCE (.env.example)
# ==============================================================================
# - Backend variables (Render): Copy to backend/.env
# - Frontend variables (Vercel): Copy to frontend/.env (MUST prefix with VITE_)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVER CONFIGURATION (Render)
# ------------------------------------------------------------------------------
# [OPTIONAL] [PUBLIC]
NODE_ENV=development
PORT=5001

# [REQUIRED in Prod] [PUBLIC]
FRONTEND_URL=http://localhost:5173

# [OPTIONAL] [PUBLIC]
CORS_ORIGINS=http://localhost:5173
SOCKET_CORS_ORIGINS=http://localhost:5173

# [REQUIRED in Prod] [SECRET] Database (MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/smart_procurement_db

# [REQUIRED in Prod] [SECRET] Authentication (JWT)
JWT_SECRET=super_secret_sih_2026_gov_key_change_in_production
JWT_EXPIRES_IN=24h

# [OPTIONAL] Pre-provisioned Demo Administrator Credentials
ADMIN_EMAIL=admin@agrinexus.gov.in
ADMIN_PASSWORD=adminpassword

# [OPTIONAL] [PUBLIC] Payment Processing Mode ('SIMULATED' | 'DEMO' | 'PRODUCTION')
PAYMENT_MODE=SIMULATED

# [OPTIONAL] [SECRET] Digital India Bhashini APIs (MeitY ULCA Translation Pipeline)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543d6
BHASHINI_API_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# [OPTIONAL] [SECRET] Google Maps Platform (Backend)
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 2. FRONTEND CLIENT CONFIGURATION (Vercel)
# ------------------------------------------------------------------------------
# [REQUIRED in Prod] [PUBLIC]
VITE_API_BASE_URL=http://localhost:5001/api
VITE_SOCKET_URL=http://localhost:5001

# [OPTIONAL] [PUBLIC]
VITE_APP_ENV=development

# [OPTIONAL] [PUBLIC] (Falls back cleanly to Leaflet/OpenStreetMap if omitted)
VITE_GOOGLE_MAPS_API_KEY=

